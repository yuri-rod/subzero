JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_API_KEY=
BEARER_TOKEN=
OPENSUBTITLES_API_KEY=
# login opcional: sem ele a cota e a basica da chave, com ele e a da conta (VIP = 1000/dia)
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
DB_PATH=jobs.db
STATE_PATH=watch.json
LOG_DIR=logs
WHISPER_MODEL=large-v3
# Unset picks mlx on Apple Silicon and cuda elsewhere. cpu/cuda run
# faster-whisper; mlx runs the same weights through mlx-whisper, ~2.5x faster
# with the same Silero VAD speech gating.
WHISPER_DEVICE=
WHISPER_COMPUTE_TYPE=
TRANSLATION_PROVIDER=ollama
# For the isolated native English to Brazilian Portuguese CPU runtime:
# TRANSLATION_PROVIDER=libretranslate
# LIBRETRANSLATE_RUNTIME=/absolute/path/to/subzero/libretranslate
# For Apple Foundation Models through a local OpenAI-style server (start it
# with `fm serve`); refused blocks fall back to LibreTranslate when set:
# TRANSLATION_PROVIDER=applefm
# APPLEFM_URL=http://127.0.0.1:1976
# TRANSLATION_FALLBACK=libretranslate
# deepl-free accepts the same fallbacks; applefm keeps quota spills on-device:
# TRANSLATION_PROVIDER=deepl-free
# TRANSLATION_FALLBACK=applefm
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=subzero/hy-mt2:7b
OLLAMA_KEEP_ALIVE=2m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=2048
# Defaults to 1 on macOS and 0 elsewhere.
# OCR_ENABLED=1
# Optional whole-video caption rescue; both values are required when enabled.
# Use an installed vision-capable Ollama model and its exact SHA-256 digest.
# OCR_RESCUE_MODEL=
# OCR_RESCUE_MODEL_DIGEST=
DAILY_DOWNLOAD_BUDGET=15
AUTO_LANGS=pt-BR
AUTO_ENABLED=1
AUTO_WINDOW_START=4
AUTO_WINDOW_END=7
WATCH_INTERVAL=600
IDLE_SHUTDOWN_MINUTES=15
PORT=8787
NTFY_URL=https://ntfy.sh
# empty disables every ping; manual jobs notify always, auto jobs only on failure/review/pause plus one sweep summary
NTFY_TOPIC=
ASR_COMPAT=0
ASR_MAX_MB=1024
