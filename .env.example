JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_API_KEY=
BEARER_TOKEN=
OPENSUBTITLES_API_KEY=
# Optional login uses your account allowance; otherwise the API key allowance applies.
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=
DB_PATH=jobs.db
STATE_PATH=watch.json
LOG_DIR=logs
WHISPER_MODEL=large-v3
# Unset picks mlx on Apple Silicon and cuda elsewhere. cpu/cuda run
# faster-whisper; mlx uses mlx-whisper. Both use Silero VAD to limit
# transcription to detected speech.
WHISPER_DEVICE=
WHISPER_COMPUTE_TYPE=
TRANSLATION_PROVIDER=ollama
# Route whole jobs to LibreTranslate when Ollama is down or the model is missing:
# TRANSLATION_FALLBACK=libretranslate
# For the isolated native English to Brazilian Portuguese CPU runtime:
# TRANSLATION_PROVIDER=libretranslate
# LIBRETRANSLATE_RUNTIME=/absolute/path/to/subzero/libretranslate
# For Apple Foundation Models through a local OpenAI-style server (start it
# with `fm serve`); refused blocks fall back to LibreTranslate when set:
# TRANSLATION_PROVIDER=applefm
# APPLEFM_URL=http://127.0.0.1:1976
# TRANSLATION_FALLBACK=libretranslate
# deepl-free accepts the same fallbacks; applefm keeps quota spills on-device:
# TRANSLATION_PROVIDER=deepl-free
# TRANSLATION_FALLBACK=applefm
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b-mlx
OLLAMA_KEEP_ALIVE=2m
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=2048
OLLAMA_JOBS=1
# Defaults to 1 on macOS and 0 elsewhere.
# OCR_ENABLED=1
# Optional whole-video caption rescue; both values are required when enabled.
# Use an installed vision-capable Ollama model and its exact SHA-256 digest.
# OCR_RESCUE_MODEL=
# OCR_RESCUE_MODEL_DIGEST=
AUTO_LANGS=pt-BR
AUTO_ENABLED=1
AUTO_WINDOW_START=4
AUTO_WINDOW_END=7
WATCH_INTERVAL=600
IDLE_SHUTDOWN_MINUTES=15
PORT=8787
NTFY_URL=https://ntfy.sh
# Leave empty to disable notifications. Manual jobs notify on every outcome;
# automatic jobs notify on failure, review, or pause, plus one sweep summary.
NTFY_TOPIC=
ASR_COMPAT=0
ASR_MAX_MB=1024
# qBittorrent completion trigger: the worker polls the Web API and enqueues a
# subtitle job when a torrent in these categories finishes downloading.
# QBT_ENABLED=1
# QBT_URL=http://127.0.0.1:8585
# QBT_API_KEY=
# QBT_CATEGORIES=movies,tv shows
# QBT_POLL_INTERVAL=30
